# api.nsw credentials — register free at https://api.nsw.gov.au and subscribe to "Motor API"
NSW_API_KEY=
NSW_API_SECRET=
# Several accounts: 'key:secret' pairs separated by ';' here (or one per line in the GitHub secret).
# The client drains one account, and when it answers "Quota limit exceeded" moves to the next.
NSW_API_KEYS=
# Optional: ABN Lookup GUID (https://abr.business.gov.au/Tools/WebServices). Leave blank to skip fetch-abr.
ABR_GUID=
# Wall-clock budget per run, seconds (Actions uses 3000 = 50 min)
RUN_SECONDS=3000
# 0 = no artificial monthly cap; set e.g. 2400 to stop before the free tier's 2,500 calls
MONTHLY_CALL_BUDGET=0
# 1 = no API calls, no git pushes
DRY_RUN=0
